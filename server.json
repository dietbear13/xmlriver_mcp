{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dietbear13/xmlriver-mcp-toolkit",
  "title": "XMLRiver MCP Toolkit",
  "description": "Google/Yandex organic results, Wordstat keywords and demand history using your XMLRiver account.",
  "repository": {"url": "https://github.com/dietbear13/xmlriver_mcp", "source": "github"},
  "version": "0.1.1",
  "packages": [{
    "registryType": "pypi",
    "registryBaseUrl": "https://pypi.org",
    "identifier": "xmlriver-mcp-toolkit",
    "version": "0.1.1",
    "runtimeHint": "uvx",
    "transport": {"type": "stdio"},
    "environmentVariables": [
      {"name": "XMLRIVER_USER", "description": "XMLRiver user ID", "isRequired": true, "isSecret": true},
      {"name": "XMLRIVER_KEY", "description": "XMLRiver API key", "isRequired": true, "isSecret": true}
    ]
  }]
}
